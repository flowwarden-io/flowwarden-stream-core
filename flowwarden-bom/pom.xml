<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.flowwarden</groupId>
        <artifactId>flowwarden-stream-core-parent</artifactId>
        <version>1.0.0-rc.5-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>flowwarden-bom</artifactId>
    <packaging>pom</packaging>

    <name>FlowWarden BOM</name>
    <description>Dependency Bill of Materials pinning compatible versions of the FlowWarden ecosystem artifacts (stream-core, testkit, and satellite backends). Import in your dependencyManagement to omit per-dependency versions.</description>

    <properties>
        <!-- Satellites release on their own cadence; these pins define the set validated against this core version. -->
        <flowwarden-javers.version>1.0.0-rc.2</flowwarden-javers.version>
        <flowwarden-redis.version>1.0.0-rc.2</flowwarden-redis.version>
        <flowwarden-amqp.version>1.0.0-rc.2</flowwarden-amqp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.flowwarden</groupId>
                <artifactId>flowwarden-stream-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.flowwarden</groupId>
                <artifactId>flowwarden-stream-core-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.flowwarden</groupId>
                <artifactId>flowwarden-javers</artifactId>
                <version>${flowwarden-javers.version}</version>
            </dependency>
            <dependency>
                <groupId>io.flowwarden</groupId>
                <artifactId>flowwarden-redis</artifactId>
                <version>${flowwarden-redis.version}</version>
            </dependency>
            <dependency>
                <groupId>io.flowwarden</groupId>
                <artifactId>flowwarden-amqp</artifactId>
                <version>${flowwarden-amqp.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!--
            BOM module participates in the release reactor but produces only a pom artifact.
            Skip the source/javadoc plugins inherited from the parent release profile so the
            Central pipeline doesn't reject the missing sources/javadoc artifacts.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
