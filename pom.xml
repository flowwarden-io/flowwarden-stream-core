<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>io.flowwarden</groupId>
    <artifactId>flowwarden-stream-core-parent</artifactId>
    <version>1.0.0-rc.4</version>
    <packaging>pom</packaging>

    <name>FlowWarden Stream Core (parent)</name>
    <description>Aggregator for the FlowWarden Stream Core library, its SPI testkit, and the FlowWarden BOM.</description>
    <url>https://github.com/flowwarden-io/flowwarden-stream-core</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>FlowWarden</name>
        <url>https://flowwarden.io</url>
    </organization>

    <developers>
        <developer>
            <id>cedricclausPro</id>
            <name>Cédric Claus</name>
            <email>62853718+cedricclausPro@users.noreply.github.com</email>
            <url>https://github.com/cedricclausPro</url>
            <organization>FlowWarden</organization>
            <organizationUrl>https://flowwarden.io</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/flowwarden-io/flowwarden-stream-core.git</connection>
        <developerConnection>scm:git:git@github.com:flowwarden-io/flowwarden-stream-core.git</developerConnection>
        <url>https://github.com/flowwarden-io/flowwarden-stream-core</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/flowwarden-io/flowwarden-stream-core/issues</url>
    </issueManagement>

    <modules>
        <module>flowwarden-stream-core</module>
        <module>flowwarden-stream-core-testkit</module>
        <module>flowwarden-stream-core-mongo-it</module>
        <module>flowwarden-bom</module>
    </modules>

    <!-- SNAPSHOTs only: CI publishes main snapshots to GitHub Packages so the
         satellite repos can build against unreleased core between releases.
         Releases never go through here — they ship to Maven Central via the
         central-publishing plugin in the `release` profile. -->
    <distributionManagement>
        <snapshotRepository>
            <id>github</id>
            <url>https://maven.pkg.github.com/flowwarden-io/flowwarden-stream-core</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <java.version>17</java.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <mockito.version>5.23.0</mockito.version>
        <byte-buddy.version>1.17.5</byte-buddy.version>
        <license.year>2026</license.year>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-bom</artifactId>
                <version>${mockito.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.mycila</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>5.1.1</version>
                    <configuration>
                        <licenseSets>
                            <licenseSet>
                                <header>${maven.multiModuleProjectDirectory}/.license-header.txt</header>
                                <includes>
                                    <include>src/**/*.java</include>
                                </includes>
                            </licenseSet>
                        </licenseSets>
                        <properties>
                            <license.year>${license.year}</license.year>
                        </properties>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Release profile — activated explicitly for Maven Central deployments.
            Usage:  ./mvnw -P release clean deploy
            Requires:
              - GPG key configured locally and on Sonatype keyserver
              - credentials for server id 'central' in ~/.m2/settings.xml
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Attach -sources.jar (required by Maven Central) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Attach -javadoc.jar (required by Maven Central) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <doclint>none</doclint>
                            <source>${java.version}</source>
                        </configuration>
                    </plugin>

                    <!-- GPG-sign all artifacts (required by Maven Central) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Sonatype Central Publisher (new portal — replaces nexus-staging) -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Manual publish from Central portal for safety on first releases. -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!--
                                Keep the internal integration-test module out of the aggregated
                                Central bundle. In a multi-module reactor this plugin builds a
                                single bundle for the whole reactor; a child <skipPublishing>true</skipPublishing>
                                does not remove that module's artifacts from the aggregate, so the
                                unsigned mongo-it jar/pom would otherwise reach Central and fail
                                validation. Exclude it here on the aggregator instead.
                            -->
                            <!-- Matched against artifactId only (the plugin filters on
                                 Artifact.getArtifactId()); a structured groupId/artifactId
                                 element fails config parsing. -->
                            <excludeArtifacts>
                                <artifact>flowwarden-stream-core-mongo-it</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
